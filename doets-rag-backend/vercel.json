{
  "version": 2,
  "name": "doets-rag-backend",
  "env": {
    "PINECONE_API_KEY": "pcsk_3ayZeq_EjZwTAp7f1AS1BF634rXjTqDaMFP27jo9RRMPzoKDYofcyjSpYsoz6A6yH6X4LK",
    "PINECONE_INDEX": "doets-knowledge"
  },
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}
